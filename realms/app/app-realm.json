{
  "realm": "app",
  "enabled": true,
  "displayName": "App (SAML Service Provider)",
  "identityProviders": [
    {
      "alias": "corp-saml",
      "displayName": "Corp login",
      "providerId": "saml",
      "enabled": true,
      "trustEmail": true,
      "config": {
        "entityId": "http://localhost:8280/realms/app",
        "idpEntityId": "http://localhost:8180/realms/corp",
        "singleSignOnServiceUrl": "http://localhost:8180/realms/corp/protocol/saml",
        "singleLogoutServiceUrl": "http://localhost:8180/realms/corp/protocol/saml",
        "metadataDescriptorUrl": "http://corp-idp:8080/realms/corp/protocol/saml/descriptor",
        "useMetadataDescriptorUrl": "true",
        "validateSignature": "true",
        "wantAuthnRequestsSigned": "true",
        "signatureAlgorithm": "RSA_SHA256",
        "postBindingAuthnRequest": "true",
        "postBindingResponse": "true",
        "postBindingLogout": "true",
        "nameIDPolicyFormat": "urn:oasis:names:tc:SAML:1.1:nameid-format:unspecified",
        "principalType": "SUBJECT",
        "syncMode": "FORCE",
        "allowCreate": "true"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "email", "identityProviderAlias": "corp-saml", "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": { "syncMode": "FORCE", "attribute.name": "email", "user.attribute": "email" }
    },
    {
      "name": "firstName", "identityProviderAlias": "corp-saml", "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": { "syncMode": "FORCE", "attribute.name": "firstName", "user.attribute": "firstName" }
    },
    {
      "name": "lastName", "identityProviderAlias": "corp-saml", "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": { "syncMode": "FORCE", "attribute.name": "lastName", "user.attribute": "lastName" }
    }
  ]
}
